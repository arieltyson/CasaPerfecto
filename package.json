{
  "name": "casaperfecto",
  "version": "0.1.0",
  "description": "A private, map-based apartment search companion for renters who want to walk to work.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/check-budget.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "e2e": "playwright test",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.node.json",
    "lint": "oxlint --deny-warnings && node scripts/check-design.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run build && npm test",
    "pipeline": "node pipeline/run.ts",
    "icons": "node scripts/render-icons.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "maplibre-gl": "6.11.2",
    "pmtiles": "4.5.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "@protomaps/basemaps": "5.7.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "fast-png": "8.0.0",
    "fflate": "0.8.3",
    "jsdom": "30.1.2",
    "oxlint": "1.87.0",
    "prettier": "3.9.9",
    "typescript": "7.0.2",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
